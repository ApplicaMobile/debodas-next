generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  role         String   @default("couple")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  boda               Boda?
  passwordResetTokens PasswordResetToken[]
  adminAuditLogs      AdminAuditLog[] @relation("AdminAuditActor")

  @@index([role])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  keyHash   String   @unique @db.Char(64) @map("key_hash")
  count     Int      @default(1)
  resetAt   DateTime @map("reset_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  actorEmail  String   @map("actor_email")
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  metadata    Json     @default("{}")
  ipHash      String?  @db.Char(64) @map("ip_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model EmailLog {
  id               String    @id @default(cuid())
  type             String    @default("generic")
  dedupeKey        String?   @unique @map("dedupe_key")
  toAddress        String    @map("to_address")
  replyTo          String?   @map("reply_to")
  subject          String
  contentEncrypted String?   @db.LongText @map("content_encrypted")
  status           String    @default("queued")
  attempts         Int       @default(0)
  maxAttempts      Int       @default(5) @map("max_attempts")
  availableAt      DateTime  @default(now()) @map("available_at")
  lockedAt         DateTime? @map("locked_at")
  lockedBy         String?   @map("locked_by")
  providerId       String?   @map("provider_id")
  error            String?   @db.Text
  meta             Json      @default("{}")
  sentAt           DateTime? @map("sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([status, availableAt, createdAt])
  @@index([status, lockedAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@map("email_logs")
}

model Boda {
  id               String    @id @default(cuid())
  userId           String    @unique @map("user_id")
  slug             String    @unique
  title            String
  plan             String    @default("free")
  micrositeTheme   String    @default("base") @map("microsite_theme")
  couple           Json
  event            Json
  banner           Json      @default("{}")
  options          Json      @default("{}")
  misc             Json      @default("{}")
  giftsListTitle   String?   @map("gifts_list_title")
  featuredImageUrl String?   @map("featured_image_url")
  isOnline         Boolean   @default(false) @map("is_online")
  ratingEmailSentAt DateTime? @map("rating_email_sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gifts          Gift[]
  pictures       Picture[]
  scheduleItems  ScheduleItem[]
  faqItems       FaqItem[]
  rsvpGuests     RsvpGuest[]
  payments       Payment[]
  confirmedGifts ConfirmedGift[]
  ratings        Rating[]

  @@index([isOnline])
  @@index([createdAt])
  @@index([plan])
  @@map("bodas")
}

model Rating {
  id        String   @id @default(cuid())
  bodaId    String   @map("boda_id")
  name      String
  email     String
  score     Int
  comment   String?  @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  @@unique([bodaId, email])
  @@index([bodaId])
  @@index([status])
  @@map("ratings")
}

model Gift {
  id        String   @id @default(cuid())
  bodaId    String   @map("boda_id")
  title     String
  price     Decimal  @db.Decimal(12, 2)
  quantity  Int      @default(1)
  imageUrl  String?  @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  @@index([bodaId])
  @@map("gifts")
}

model Picture {
  id        String   @id @default(cuid())
  bodaId    String   @map("boda_id")
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  @@index([bodaId])
  @@map("pictures")
}

model ScheduleItem {
  id          String   @id @default(cuid())
  bodaId      String   @map("boda_id")
  time        String
  title       String
  description String?  @db.Text
  icon        String   @default("anillos")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  @@index([bodaId])
  @@map("schedule_items")
}

model FaqItem {
  id        String   @id @default(cuid())
  bodaId    String   @map("boda_id")
  question  String   @db.Text
  answer    String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  @@index([bodaId])
  @@map("faq_items")
}

model RsvpGuest {
  id        String   @id @default(cuid())
  bodaId    String   @map("boda_id")
  name      String
  email     String?
  status    String   @default("pending")
  menu      String   @default("general")
  tableName String?  @map("table_name")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  @@index([bodaId])
  @@map("rsvp_guests")
}

model Payment {
  id             String   @id @default(cuid())
  bodaId         String   @map("boda_id")
  type           String
  planTarget     String?  @map("plan_target")
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("ARS")
  status         String   @default("pending")
  mpPreferenceId String?  @map("mp_preference_id")
  mpPaymentId    String?  @unique @map("mp_payment_id")
  externalRef    String   @unique @map("external_ref")
  payerEmail     String?  @map("payer_email")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  confirmedGift ConfirmedGift?

  @@index([bodaId])
  @@index([status])
  @@map("payments")
}

model ConfirmedGift {
  id           String   @id @default(cuid())
  bodaId       String   @map("boda_id")
  paymentId    String?  @unique @map("payment_id")
  participants String
  email        String?
  phone        String?
  dedication   String?  @db.Text
  method       String
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("ARS")
  items        Json     @default("[]")
  voucherUrl   String?  @map("voucher_url")
  confirmed    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  boda    Boda     @relation(fields: [bodaId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([bodaId])
  @@index([confirmed])
  @@map("confirmed_gifts")
}
