generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String?
  role           String   @default("couple")
  sessionVersion Int      @default(0) @map("session_version")
  /// Hash original de WordPress ($wp$2y$, $P$ o MD5). Se verifica en el primer login y se vacía al rehashear.
  legacyPasswordHash String?   @map("legacy_password_hash") @db.VarChar(255)
  /// ID de wp_users de origen (solo el usuario "principal" de ese ID).
  legacyWpUserId     Int?      @unique @map("legacy_wp_user_id")
  /// Cuenta importada desde WordPress (pantalla de bienvenida).
  migratedFromWp     Boolean   @default(false) @map("migrated_from_wp")
  welcomeSeenAt      DateTime? @map("welcome_seen_at")
  /// Estado de la cuenta: active | suspended | deleted (baja lógica, no se borran filas).
  status             String    @default("active") @db.VarChar(16)
  statusChangedAt    DateTime? @map("status_changed_at")
  statusReason       String?   @map("status_reason") @db.VarChar(500)
  deletedAt          DateTime? @map("deleted_at")
  /// Borrado definitivo pedido por la pareja (derecho al olvido): datos anonimizados, no se restaura.
  erasedAt           DateTime? @map("erased_at")
  /// Email confirmado con código. null = registro sin verificar. El default now() hace que
  /// cualquier alta que no sea el registro público (WP, scripts, admin) quede verificada;
  /// registerAccount lo pone en null explícitamente.
  emailVerifiedAt    DateTime? @default(now()) @map("email_verified_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  boda               Boda?
  passwordResetTokens PasswordResetToken[]
  adminAuditLogs      AdminAuditLog[] @relation("AdminAuditActor")
  verificationCodes   VerificationCode[]

  @@index([role])
  @@index([migratedFromWp])
  @@index([status])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Código de un solo uso (6 dígitos) para confirmar el borrado definitivo de la cuenta.
/// Solo se guarda el HMAC del código. Uno por usuario: pedir otro reemplaza al anterior.
/// Códigos de un solo uso (6 dígitos) enviados por email: verificación del registro,
/// borrado de cuenta… Solo se guarda un HMAC. Uno vigente por usuario y propósito.
model VerificationCode {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  /// email_verification | account_deletion
  purpose   String   @db.VarChar(32)
  codeHash  String   @map("code_hash") @db.Char(64)
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  sentAt    DateTime @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
  @@map("verification_codes")
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  keyHash   String   @unique @db.Char(64) @map("key_hash")
  count     Int      @default(1)
  resetAt   DateTime @map("reset_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  actorEmail  String   @map("actor_email")
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  metadata    Json     @default("{}")
  ipHash      String?  @db.Char(64) @map("ip_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model SystemHeartbeat {
  id        String   @id
  lastRunAt DateTime @map("last_run_at")
  meta      Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_heartbeats")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model EmailLog {
  id               String    @id @default(cuid())
  type             String    @default("generic")
  dedupeKey        String?   @unique @map("dedupe_key")
  toAddress        String    @map("to_address")
  replyTo          String?   @map("reply_to")
  subject          String
  contentEncrypted String?   @db.LongText @map("content_encrypted")
  status           String    @default("queued")
  attempts         Int       @default(0)
  maxAttempts      Int       @default(5) @map("max_attempts")
  availableAt      DateTime  @default(now()) @map("available_at")
  lockedAt         DateTime? @map("locked_at")
  lockedBy         String?   @map("locked_by")
  providerId       String?   @map("provider_id")
  error            String?   @db.Text
  meta             Json      @default("{}")
  sentAt           DateTime? @map("sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([status, availableAt, createdAt])
  @@index([status, lockedAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@map("email_logs")
}

model Boda {
  id               String    @id @default(cuid())
  userId           String    @unique @map("user_id")
  slug             String    @unique
  title            String
  plan             String    @default("free")
  micrositeTheme   String    @default("base") @map("microsite_theme")
  couple           Json
  event            Json
  banner           Json      @default("{}")
  options          Json      @default("{}")
  misc             Json      @default("{}")
  giftsListTitle   String?   @map("gifts_list_title")
  featuredImageUrl String?   @map("featured_image_url")
  isOnline         Boolean   @default(false) @map("is_online")
  ratingEmailSentAt DateTime? @map("rating_email_sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gifts          Gift[]
  pictures       Picture[]
  scheduleItems  ScheduleItem[]
  faqItems       FaqItem[]
  rsvpGuests     RsvpGuest[]
  payments       Payment[]
  confirmedGifts ConfirmedGift[]
  ratings        Rating[]
  notifications  Notification[]

  @@index([isOnline])
  @@index([createdAt])
  @@index([plan])
  @@map("bodas")
}

model Notification {
  id        String    @id @default(cuid())
  bodaId    String    @map("boda_id")
  type      String
  title     String
  body      String?   @db.Text
  href      String
  entityId  String?   @map("entity_id")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  @@index([bodaId, createdAt])
  @@index([bodaId, readAt, createdAt])
  @@map("notifications")
}

model Rating {
  id        String   @id @default(cuid())
  bodaId    String   @map("boda_id")
  name      String
  email     String
  score     Int
  comment   String?  @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  @@unique([bodaId, email])
  @@index([bodaId])
  @@index([status])
  @@map("ratings")
}

model Gift {
  id        String   @id @default(cuid())
  bodaId    String   @map("boda_id")
  title     String
  price     Decimal  @db.Decimal(12, 2)
  quantity  Int      @default(1)
  imageUrl  String?  @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  @@index([bodaId])
  @@map("gifts")
}

model Picture {
  id        String   @id @default(cuid())
  bodaId    String   @map("boda_id")
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  @@index([bodaId])
  @@map("pictures")
}

model ScheduleItem {
  id          String   @id @default(cuid())
  bodaId      String   @map("boda_id")
  time        String
  title       String
  description String?  @db.Text
  icon        String   @default("anillos")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  @@index([bodaId])
  @@map("schedule_items")
}

model FaqItem {
  id        String   @id @default(cuid())
  bodaId    String   @map("boda_id")
  question  String   @db.Text
  answer    String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  @@index([bodaId])
  @@map("faq_items")
}

model RsvpGuest {
  id        String   @id @default(cuid())
  bodaId    String   @map("boda_id")
  name      String
  email     String?
  status    String   @default("pending")
  menu      String   @default("general")
  tableName String?  @map("table_name")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  @@index([bodaId])
  @@map("rsvp_guests")
}

model Payment {
  id             String   @id @default(cuid())
  bodaId         String   @map("boda_id")
  type           String
  planTarget     String?  @map("plan_target")
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("ARS")
  status         String   @default("pending")
  mpPreferenceId String?  @map("mp_preference_id")
  mpPaymentId    String?  @unique @map("mp_payment_id")
  externalRef    String   @unique @map("external_ref")
  payerEmail     String?  @map("payer_email")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  boda Boda @relation(fields: [bodaId], references: [id], onDelete: Cascade)

  confirmedGift ConfirmedGift?

  @@index([bodaId])
  @@index([status])
  @@map("payments")
}

model ConfirmedGift {
  id           String   @id @default(cuid())
  bodaId       String   @map("boda_id")
  paymentId    String?  @unique @map("payment_id")
  participants String
  email        String?
  phone        String?
  dedication   String?  @db.Text
  method       String
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("ARS")
  items        Json     @default("[]")
  voucherUrl   String?  @map("voucher_url")
  confirmed    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  boda    Boda     @relation(fields: [bodaId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([bodaId])
  @@index([confirmed])
  @@map("confirmed_gifts")
}

/// Mapeo de IDs WordPress → Prisma para que la importación sea idempotente.
/// kind: "user" | "boda" | "rating". La identidad es (kind, wp_id), no el slug.
model LegacyMap {
  id         String   @id @default(cuid())
  kind       String   @db.VarChar(32)
  wpId       Int      @map("wp_id")
  prismaId   String   @map("prisma_id") @db.VarChar(191)
  /// sha256 del post + meta al momento del último import (modo --changed).
  sourceHash String?  @map("source_hash") @db.Char(64)
  importedAt DateTime @default(now()) @map("imported_at")
  runId      String?  @map("run_id") @db.VarChar(64)

  @@unique([kind, wpId])
  @@index([kind, prismaId])
  @@map("legacy_map")
}

/// Archivos de wp-content/uploads ya copiados (rehost). Dedupe global por sha256 del contenido.
model LegacyMedia {
  id             String   @id @default(cuid())
  wpAttachmentId Int?     @map("wp_attachment_id")
  /// URL original normalizada (sin query ni hash).
  originalUrl    String   @unique @map("original_url") @db.VarChar(768)
  sha256         String   @db.Char(64)
  newPath        String   @map("new_path") @db.VarChar(1024)
  bytes          Int
  contentType    String?  @map("content_type") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([sha256])
  @@index([wpAttachmentId])
  @@map("legacy_media")
}
