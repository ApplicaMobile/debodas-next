{
  "name": "debodas-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/email-crypto.test.ts tests/admin-audit-labels.test.ts tests/system-health.test.ts tests/session-version.test.ts tests/maintenance-config.test.ts",
    "test:e2e:setup": "tsx tests/e2e/setup-db.ts",
    "test:e2e": "npm run test:e2e:setup && playwright test",
    "test:e2e:ui": "npm run test:e2e:setup && playwright test --ui",
    "postinstall": "prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:backup": "tsx scripts/backup-mariadb.ts",
    "db:import-wp": "dotenv -e .env.local -- tsx scripts/import-wp.ts",
    "email:test": "tsx scripts/test-smtp.ts",
    "share": "npm run build && next start"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dictionary-es": "^4.0.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "mysql2": "^3.23.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
